<?xml version="1.0" encoding="UTF-8"?>
<!--
  Susen custom actions for Thunar.

  Thunar keeps every custom action in one per-user file, ~/.config/Thunar/uca.xml, so a package
  cannot add to it cleanly. Either add these through Edit > Configure custom actions… (copy the
  name, command and file types below), or paste the <action> elements inside the <actions>
  element of ~/.config/Thunar/uca.xml while Thunar is closed (thunar -q).

  %F is the selected files. Replace `susen` with `flatpak run io.github.sphanx.Susen`
  for the Flatpak.
-->
<actions>
<action>
	<icon>io.github.sphanx.Susen</icon>
	<name>Open in Susen wheel…</name>
	<submenu>Susen</submenu>
	<unique-id>susen-wheel</unique-id>
	<command>susen --wheel -- %F</command>
	<description>Choose a conversion on the Susen wheel</description>
	<range>*</range>
	<patterns>*</patterns>
	<other-files/>
	<image-files/>
	<audio-files/>
	<video-files/>
	<text-files/>
</action>
<action>
	<icon>io.github.sphanx.Susen</icon>
	<name>Convert to PNG</name>
	<submenu>Susen</submenu>
	<unique-id>susen-to-png</unique-id>
	<command>susen --convert png --notify -- %F</command>
	<description>Convert the selected images to PNG</description>
	<range>*</range>
	<patterns>*</patterns>
	<image-files/>
</action>
<action>
	<icon>io.github.sphanx.Susen</icon>
	<name>Convert to JPG</name>
	<submenu>Susen</submenu>
	<unique-id>susen-to-jpg</unique-id>
	<command>susen --convert jpg --notify -- %F</command>
	<description>Convert the selected images to JPG</description>
	<range>*</range>
	<patterns>*</patterns>
	<image-files/>
</action>
<action>
	<icon>io.github.sphanx.Susen</icon>
	<name>Convert to MP3</name>
	<submenu>Susen</submenu>
	<unique-id>susen-to-mp3</unique-id>
	<command>susen --convert mp3 --notify -- %F</command>
	<description>Convert the selected audio or video to MP3</description>
	<range>*</range>
	<patterns>*</patterns>
	<audio-files/>
	<video-files/>
</action>
<action>
	<icon>io.github.sphanx.Susen</icon>
	<name>Convert to MP4</name>
	<submenu>Susen</submenu>
	<unique-id>susen-to-mp4</unique-id>
	<command>susen --convert mp4 --notify -- %F</command>
	<description>Convert the selected videos to MP4</description>
	<range>*</range>
	<patterns>*</patterns>
	<video-files/>
</action>
<action>
	<icon>io.github.sphanx.Susen</icon>
	<name>Compress</name>
	<submenu>Susen</submenu>
	<unique-id>susen-compress</unique-id>
	<command>susen --tool compress --notify -- %F</command>
	<description>Make the selected images, audio, video or PDFs smaller</description>
	<range>*</range>
	<patterns>*.pdf;*.PDF</patterns>
	<image-files/>
	<audio-files/>
	<video-files/>
</action>
</actions>
