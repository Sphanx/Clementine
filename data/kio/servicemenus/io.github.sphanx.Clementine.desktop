# Clementine service menu for all files (Dolphin / KDE Frameworks 6).
# See README.md > File managers.
[Desktop Entry]
Type=Service
X-KDE-ServiceTypes=KonqPopupMenu/Plugin
MimeType=all/allfiles;
Actions=wheel;zip;
X-KDE-Priority=TopLevel
X-KDE-Submenu=Clementine
X-KDE-Protocols=file

[Desktop Action wheel]
Name=Open in Clementine wheel…
Icon=io.github.sphanx.Clementine
Exec=clementine --wheel -- %F

[Desktop Action zip]
Name=Zip
Icon=io.github.sphanx.Clementine
Exec=clementine --tool zip --notify -- %F
