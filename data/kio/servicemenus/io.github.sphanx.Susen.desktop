# Susen service menu for all files (Dolphin / KDE Frameworks 6).
# See README.md > File managers.
[Desktop Entry]
Type=Service
X-KDE-ServiceTypes=KonqPopupMenu/Plugin
MimeType=all/allfiles;
Actions=wheel;zip;
X-KDE-Priority=TopLevel
X-KDE-Submenu=Susen
X-KDE-Protocols=file

[Desktop Action wheel]
Name=Open in Susen wheel…
Icon=io.github.sphanx.Susen
Exec=susen --wheel -- %F

[Desktop Action zip]
Name=Zip
Icon=io.github.sphanx.Susen
Exec=susen --tool zip --notify -- %F
